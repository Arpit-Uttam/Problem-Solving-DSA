class Solution {
    public int findLucky(int[] arr) {
        HashMap<Integer,Integer> map=new HashMap<>();
        int ans=-1;
        for(int i: arr){
            map.put(i,map.getOrDefault(i,0)+1);
        }
        for(int e: map.keySet()){
        
            if(e==map.get(e)) ans=Math.max(ans, e);
        }
        return ans;
    }
}