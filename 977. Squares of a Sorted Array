class Solution {
    public int[] sortedSquares(int[] nums) {
        int n = nums.length;
        int[] arr = new int[n];
        
        int i = 0;     // Left pointer
        int j = n - 1; // Right pointer
        int k = n - 1; // Position to fill in the new array (from back to front)
        
        while (i <= j) {
            if (nums[i] * nums[i] > nums[j] * nums[j]) {
                arr[k] = nums[i] * nums[i];
                i++; // Only move the left pointer when we use its value
            } else {
                arr[k] = nums[j] * nums[j];
                j--; // Only move the right pointer when we use its value
            }
            k--; // Always move the array placement pointer backward
        }
        
        return arr;
    }
}
