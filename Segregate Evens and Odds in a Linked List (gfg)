class Solution {
    Node divide(Node head) {
        // code here
        Node d1=new Node(-1);
        Node d2=new Node(-1);
        Node t1=d1;
        Node t2=d2;
        while(head!=null){
            if(head.data%2==0){
                t1.next=head;
                t1=t1.next;
            }
            else{
                t2.next=head;
                t2=t2.next;
            }
            head=head.next;
        }
        t2.next=null;
        t1.next=d2.next;
        return d1.next;
    }
}