class Solution {
    public Queue<Integer> reverseFirstK(Queue<Integer> q, int k) {
        if(k>q.size()) return q;
        Stack<Integer> st= new Stack<>();
        for(int i=0; i<k;i++){
            st.push(q.remove());
        }

        for(int i=0; i<k;i++){
            q.add(st.pop());
        }
        for(int i=0; i<q.size()-k;i++){
            q.add(q.remove());
        }
        return q;
    }
}