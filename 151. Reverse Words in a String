class Solution {
    public String reverseWords(String s) {
        String str = s.trim();
        StringBuilder ans = new StringBuilder();
        
        int j = str.length();
        
        for (int i = str.length() - 1; i >= 0; i--) {
            if (str.charAt(i) == ' ') {
                if (i + 1 < j) { // avoid multiple spaces
                    ans.append(str.substring(i + 1, j));
                    ans.append(" ");
                }
                j = i;
            } else if (i == 0) {
                ans.append(str.substring(0, j));
            }
        }
        
        return ans.toString();
    }
}
