//brute force approch it is not best beacuase it is not giving the result in one go
class Solution {
    public ListNode middleNode(ListNode head) {
        int length=0;
        ListNode temp=head;
        while(temp!=null){
            temp=temp.next;
            length++;
        }
        temp=head;
        for(int i=1;i<=length/2;i++){
            temp=temp.next;
        }
        return temp;
    }
}


//optimised solution using slow and fast approach

class Solution {
    public ListNode middleNode(ListNode head) {
        ListNode slow=head;
        ListNode fast=head;
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
        }
        return slow;
    }
}