class Solution {
    public ArrayList<Integer> frequencyCount(int[] arr) {
        int n = arr.length;
        ArrayList<Integer> nums = new ArrayList<>();

        // Initialize frequencies with 0
        for (int i = 0; i < n; i++) {
            nums.add(0);
        }

        // Count frequencies
        for (int i = 0; i < n; i++) {
            int val = arr[i];      // values are from 1 to n
            nums.set(val - 1, nums.get(val - 1) + 1);
        }

        return nums;
    }
}