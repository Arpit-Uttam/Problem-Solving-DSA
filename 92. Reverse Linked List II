class Solution {
    public ListNode rev(ListNode head) {
        ListNode curr = head, fwd = null, prev = null;
        while (curr != null) {
            fwd = curr.next;
            curr.next = prev;
            prev = curr;
            curr = fwd;
        }
        return prev;
    }

    public ListNode reverseBetween(ListNode head, int left, int right) {
        if (head == null || left == right) return head;

        // Dummy node handles the edge case where left = 1
        ListNode dummy = new ListNode(0);
        dummy.next = head;
        
        // 1. Traverse to the node right before the 'left' position
        ListNode preLeft = dummy;
        for (int i = 1; i < left; i++) {
            preLeft = preLeft.next;
        }
        
        // 2. Mark the start of the sublist to be reversed
        ListNode subStart = preLeft.next;
        
        // 3. Traverse to the 'right' node
        ListNode subEnd = subStart;
        for (int i = 0; i < (right - left); i++) {
            subEnd = subEnd.next;
        }
        
        // 4. Disconnect the sublist and save the trailing remaining list
        ListNode postRight = subEnd.next;
        subEnd.next = null; // Break connection to reverse cleanly
        preLeft.next = null; // Break connection from the front
        
        // 5. Reverse the isolated sublist
        rev(subStart);
        
        // 6. Reconnect the pieces
        preLeft.next = subEnd;
        subStart.next = postRight;
        
        return dummy.next;
    }
}
