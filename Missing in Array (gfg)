//solved using cyclic sort
class Solution {
    int missingNum(int arr[]) {
        int i=0;
        int max=arr.length+1;
        while(i<arr.length){
            int n=arr[i];
            if(n==i+1 || arr[i]==max) i++;
            else{
                arr[i]=arr[n-1];
                arr[n-1]=n;
            }
        }
        for(i=0;i<arr.length;i++){
            if(arr[i]!=i+1) return i+1;
        }
        return arr.length+1;  
    }
}