//brute force code using Binary Search
class Solution {
    public int singleNonDuplicate(int[] nums) {
        int n=nums.length;
        int l=0,h=n-1,mid=-1;
        if(n==1) return nums[0];
        while(l<=h){
            mid=(l+h)/2;
            if(mid>0 && mid<n-1 && nums[mid]!=nums[mid-1] && nums[mid]!=nums[mid+1]) return nums[mid];
            else if(mid==0 && nums[mid]!=nums[mid+1]) return nums[mid];
            else if(mid==n-1 && nums[mid]!=nums[mid-1]) return nums[mid];
            else if(nums[mid]==nums[mid-1]){
                if(mid%2==0) h=mid-1;
                else l=mid+1;
            }
            else {
                if(mid%2==0) l=mid+1;
                else h=mid-1;
            }
        }
        return -1;
    }
}
