class Solution {
    public void dfs(TreeNode root, StringBuilder s1,ArrayList<String> ans){
        int n=s1.length();
        if(root==null) return;
        s1.append(root.val);
        if(root.left==null && root.right==null){
            ans.add(s1.toString());  
        }
        s1.append("->");
        dfs(root.left,s1,ans);
        dfs(root.right,s1,ans);
        s1.setLength(n);
    }
    public List<String> binaryTreePaths(TreeNode root) {
        ArrayList<String> ans=new ArrayList<>();
        StringBuilder s1=new StringBuilder();
        dfs(root,s1,ans);
        return ans;
        
    }
}