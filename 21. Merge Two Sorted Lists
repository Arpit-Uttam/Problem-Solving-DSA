class Solution {
    public ListNode mergeTwoLists(ListNode list1, ListNode list2) {
        if(list1==null && list2==null) return null;
        if(list1==null) return list2;
        if(list2==null) return list1;

        ListNode d=new ListNode(-1);
        ListNode t1=list1;
        ListNode t2=list2;
        ListNode temp=d;
        while(t1!=null && t2!=null){
            if(t1.val<=t2.val){
                temp.next=t1;
                t1=t1.next;
                temp=temp.next;
            } 
            else
            {
                temp.next=t2;
                t2=t2.next;
                temp=temp.next;
            }

        }
        if(t1 != null)
            temp.next = t1;
        else
            temp.next = t2;
        return d.next;
        
    }
}