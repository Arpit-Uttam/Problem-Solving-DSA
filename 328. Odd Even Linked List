class Solution {
    public ListNode oddEvenList(ListNode head) {
        if(head==null ||head.next==null) return head;
        ListNode d1=new ListNode(-1);
        ListNode d2=new ListNode(-1);
        ListNode t1=d1,t2=d2;
        while(head!=null){
            t1.next=head;
            t1=t1.next;
            head=head.next;
            t2.next=head;
            t2=t2.next;
            if(head!=null)head=head.next;
        }
        t1.next=d2.next;
        return d1.next;

    }
}