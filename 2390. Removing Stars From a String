//using StringBuilder

class Solution {
    public String removeStars(String s) {
        StringBuilder sb=new StringBuilder();
        for(char c:s.toCharArray())
        {
            if(c!='*') sb.append(c);
            else
             sb.deleteCharAt(sb.length()-1);
        }
        return sb.toString();
    }
}

//using stack

class Solution {
    public String removeStars(String s) {
        Stack<Character> st=new Stack<>();
        StringBuilder sb=new StringBuilder();
        int n=s.length();
        for(int i=0;i<n;i++)
        {
            if(s.charAt(i)!='*') st.push(s.charAt(i));
            else
             st.pop();
        }
        while(st.size()!=0){
            sb.insert(0,st.pop());
        }
       
        return sb.toString();
    }
}